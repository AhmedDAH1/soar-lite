# Copy to .env and fill in. Never commit .env.

# Application
APP_NAME=SOAR-Lite
# true enables the API docs at /docs (development only)
DEBUG=false

# Database (choose one)
# SQLite (development):
# DATABASE_URL=sqlite:///./soar_lite.db
# PostgreSQL:
DATABASE_URL=postgresql://soar_user:your_password@localhost:5432/soar_lite

# Webhooks: every sender signs its requests with this secret, and webhooks are
# refused until it is set. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=

# API keys for IOC enrichment (optional)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# Analyze page: the detection tools' HTTP APIs
LOG_ANALYZER_URL=http://localhost:5001
EMAIL_ANALYZER_URL=http://localhost:5002

# AI triage (off until a model is set). Either a preset...
# TRIAGE_PROVIDER=deepseek
# ...or any OpenAI-compatible API:
# TRIAGE_BASE_URL=https://api.deepseek.com
# TRIAGE_MODEL=deepseek-flash
# TRIAGE_API_KEY=
# Local model with Ollama (no key):
# TRIAGE_BASE_URL=http://localhost:11434/v1
# TRIAGE_MODEL=qwen2.5:7b
# TRIAGE_MODE=strict

# Public demo only: seed sample incidents and refuse every change
# DEMO_MODE=true
